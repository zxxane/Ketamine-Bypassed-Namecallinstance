refreshList = function()
    for _, c in ipairs(list:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    local function style(b, sel, live)
        b.BorderSizePixel = 0
        b.AutoButtonColor = true
        b.Font = Enum.Font.Gotham
        b.TextSize = 11
        b.TextColor3 = Color3.fromRGB(230, 230, 230)
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.TextWrapped = true
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
        local p = Instance.new("UIPadding")
        p.PaddingLeft = UDim.new(0, 6)
        p.Parent = b
        if sel then b.BackgroundColor3 = Color3.fromRGB(60, 110, 190)
        elseif live then b.BackgroundColor3 = Color3.fromRGB(30, 80, 50)
        else b.BackgroundColor3 = Color3.fromRGB(30, 34, 48) end
    end

    for _, e in ipairs(State.Logs) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -2, 0, 40)
        b.Parent = list
        style(b, State.Selected == e, true)
        b.Text = string.format("[LIVE %s x%d] %s\n%s", e.Method, e.Count, e.Path, e.ArgsPreview)
        b.MouseButton1Click:Connect(function()
            State.Selected = e
            State.SelectedInst = e.Remote
            refreshList()
            setStatus("Live: " .. e.Path)
        end)
    end

    for _, r in ipairs(State.Found) do
        local p = pathOf(r)
        local on = State.Monitored[p] ~= nil
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -2, 0, 28)
        b.Parent = list
        style(b, State.SelectedInst == r, on)
        b.Text = (on and "[ON] " or "") .. p
        b.MouseButton1Click:Connect(function()
            State.SelectedInst = r
            State.Selected = nil
            refreshList()
            setStatus(p)
        end)
    end
end

