    if not r then return setStatus("Select a remote") end
    local ok, err = monitorOne(r)
    setStatus(ok and ("ON " .. pathOf(r)) or tostring(err))
    refreshList()
end)

bAll.MouseButton1Click:Connect(function()
    local ok, err = monitorAll()
    setStatus(ok and "Broad ON" or tostring(err))
end)

bCopy.MouseButton1Click:Connect(function()
    local e, r = State.Selected, State.SelectedInst
    local path, method, prev
    if e then path, method, prev = e.Path, e.Method or "FireServer", e.ArgsPreview or "()"
    elseif r then path, method, prev = pathOf(r), r:IsA("RemoteFunction") and "InvokeServer" or "FireServer", "()"
    else return setStatus("Select first") end
    if not setclipboard then return setStatus("no clipboard") end
    local clean = path:gsub("^game%.", "")
    local s
    if method == "InvokeServer" then
        s = string.format("-- %s\nlocal remote = game.%s\nlocal result = remote:InvokeServer%s", path, clean, prev)
    else
        s = string.format("-- %s\nlocal remote = game.%s\nremote:FireServer%s", path, clean, prev)
    end
    setclipboard(s)
    setStatus("Copied")
end)

bIgn.MouseButton1Click:Connect(function()
    local path = State.Selected and State.Selected.Path or (State.SelectedInst and pathOf(State.SelectedInst))
    if not path then return setStatus("Select first") end
    State.Ignore[path] = true
    for i = #State.Logs, 1, -1 do
        if State.Logs[i].Path == path then table.remove(State.Logs, i) end
    end
    for i = #State.Found, 1, -1 do
        if pathOf(State.Found[i]) == path then table.remove(State.Found, i) end
    end
    State.Selected, State.SelectedInst = nil, nil
    refreshList()
    setStatus("Ignored")
end)

bClr.MouseButton1Click:Connect(function()
    table.clear(State.Logs)
    refreshList()
    setStatus("Cleared")
end)

UIS.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.RightShift then
        Screen.Enabled = not Screen.Enabled
    end
end)

