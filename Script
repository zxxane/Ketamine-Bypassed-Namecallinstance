local State = {
    Logs = {},
    Found = {},
    Ignore = {},
    Monitored = {},
    Selected = nil,
    SelectedInst = nil,
    Broad = false,
    MaxLogs = 80,
}

local function pathOf(x)
    local ok, p = pcall(function() return x:GetFullName() end)
    return ok and p or tostring(x)
end

local function cframeHeavy(args)
    if type(args) ~= "table" then return false end
    local n, t = 0, 0
    for i = 1, math.min(#args, 10) do
        t += 1
        local ty = typeof(args[i])
        if ty == "CFrame" or ty == "Vector3" then n += 1 end
    end
    return t > 0 and (n / t) >= 0.5
end

local function ignorePath(path, args)
    if State.Ignore[path] then return true end
    -- only auto-ignore real CFrame / movement spam (not by remote path/name)
    if args and cframeHeavy(args) then return true end
    return false
end

local function preview(args)
    if type(args) ~= "table" or #args == 0 then return "()" end
    local p = {}
    for i = 1, math.min(#args, 5) do
        local v, t = args[i], typeof(args[i])
        if t == "string" then
            p[#p+1] = string.format("%q", v:sub(1, 32))
        elseif t == "Instance" then
            local ok, n = pcall(function() return v.Name end)
            p[#p+1] = ok and n or t
        elseif t == "CFrame" or t == "Vector3" then
            p[#p+1] = t
        else
            p[#p+1] = tostring(v):sub(1, 24)
        end
    end
    if #args > 5 then p[#p+1] = "..." end
    return "(" .. table.concat(p, ", ") .. ")"
end

local refreshList

local function logRemote(remote, method, args)
    local path = pathOf(remote)
    if ignorePath(path, args) then return end
    local hit
    for _, e in ipairs(State.Logs) do
        if e.Path == path and e.Method == method then hit = e break end
    end
    local prev = preview(args)
    if hit then
        hit.Count += 1
        hit.ArgsPreview = prev
        hit.Args = args
        hit.Remote = remote
    else
        table.insert(State.Logs, 1, {
            Remote = remote, Path = path, Method = method,
            ArgsPreview = prev, Args = args, Count = 1,
        })
        while #State.Logs > State.MaxLogs do table.remove(State.Logs) end
    end
    task.defer(refreshList)
end

local function monitorOne(remote)
    if typeof(remote) ~= "Instance" then return false, "bad" end
    if not (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") or remote:IsA("UnreliableRemoteEvent")) then
        return false, "not remote"
    end
    local path = pathOf(remote)
    if State.Monitored[path] then return true end

    local ok, err = pcall(function()
        if remote:IsA("RemoteFunction") then
            local old = remote.InvokeServer
            hookfunction(old, newcclosure(function(...)
                local a = {...}
                local real = (a[1] == remote) and {select(2, ...)} or a
                logRemote(remote, "InvokeServer", real)
                return old(...)
            end))
        else
            local old = remote.FireServer
            hookfunction(old, newcclosure(function(...)
                local a = {...}
                local real = (a[1] == remote) and {select(2, ...)} or a
                logRemote(remote, "FireServer", real)
                return old(...)
            end))
        end
    end)
    if ok then State.Monitored[path] = remote return true end
    return false, err
end

local function monitorAll()
    if State.Broad then return true end
    local ok, err = pcall(function()
        local d = Instance.new("RemoteEvent")
        local old = d.FireServer
        hookfunction(old, newcclosure(function(...)
            local a = {...}
            local self = a[1]
            if typeof(self) == "Instance" and (self:IsA("RemoteEvent") or self.ClassName == "RemoteEvent") then
                logRemote(self, "FireServer", {select(2, ...)})
            end
            return old(...)
        end))
        d:Destroy()

        pcall(function()
            local d2 = Instance.new("UnreliableRemoteEvent")
            local old2 = d2.FireServer
            hookfunction(old2, newcclosure(function(...)
                local a = {...}
                if typeof(a[1]) == "Instance" then
                    logRemote(a[1], "FireServer", {select(2, ...)})
                end
                return old2(...)
            end))
            d2:Destroy()
        end)

        pcall(function()
            local d3 = Instance.new("RemoteFunction")
            local old3 = d3.InvokeServer
            hookfunction(old3, newcclosure(function(...)
                local a = {...}
                if typeof(a[1]) == "Instance" and a[1]:IsA("RemoteFunction") then
                    logRemote(a[1], "InvokeServer", {select(2, ...)})
                end
                return old3(...)
            end))
            d3:Destroy()
        end)
    end)
    if ok then State.Broad = true return true end
    return false, err
end

local function scan()
    local found = {}
    local roots = {
        game:GetService("ReplicatedStorage"),
        game:GetService("ReplicatedFirst"),
        workspace,
        Players,
    }
    pcall(function() if Players.LocalPlayer then roots[#roots+1] = Players.LocalPlayer end end)

    for _, root in ipairs(roots) do
        pcall(function()
            for _, inst in ipairs(root:GetDescendants()) do
                if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") or inst:IsA("UnreliableRemoteEvent") then
                    local p = pathOf(inst)
                    if not ignorePath(p, nil) then
                        found[#found+1] = inst
                    end
                end
            end
        end)
    end
    table.sort(found, function(a,b) return pathOf(a) < pathOf(b) end)
    State.Found = found
    return found
end

